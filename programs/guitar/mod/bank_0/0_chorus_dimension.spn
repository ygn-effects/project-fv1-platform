mem chorus_del1 4096
mem chorus_del2 4096

equ mono_in reg0
equ tone_level reg1
equ lpf_state reg2
equ hpf_state reg3
equ wet_temp reg4

equ pre_hpf 0.4

skp run, main
wlds 0, 20, 1000

main:
  ; --- CONTROLS ---
  ; Rate (POT0)
  rdax pot0, 1.0
  sof 0.20, 0.005
  wrax sin0_rate, 0

  ; Depth (POT1)
  rdax pot1, 1.0
  sof 0.03, 0
  wrax sin0_range, 0

  ; Tone (POT2)
  rdax pot2, 1.0
  sof 0.5, 0.2
  wrax tone_level, 0

  ; --- AUDIO ---
  ; Input sum
  rdax adcl, 0.5
  rdax adcr, 0.5

  ; Pre-tone shaping (HPF at ~300Hz)
  rdfx hpf_state, pre_hpf
  wrhx hpf_state, -1.0
  wrax mono_in, 1.0

  ; Write into delay lines
  wra chorus_del1, 1.0
  wra chorus_del2, 0

  ; Read the first wxoobly wobly
  cho rda, sin0, sin|reg|compc, chorus_del1^
  cho rda, sin0, sin, chorus_del1^ + 1

  ; Read the inverted woobly wobly
  cho rda, sin0, sin|compc|compa, chorus_del2^
  cho rda, sin0, sin|compa, chorus_del2^ + 1

  ; LPF
  rdax lpf_state, -1.0
  mulx tone_level
  rdax lpf_state, 1.0
  wrax lpf_state, 1.0

  ; Soft clip
  wrax wet_temp, -0.3333
  mulx wet_temp
  mulx wet_temp
  rdax wet_temp, 1.0

  ; Boost the signal
  sof 1.5, 0

  ; Output
  wrax dacl, 0
