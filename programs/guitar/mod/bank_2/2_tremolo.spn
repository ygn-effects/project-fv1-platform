; EFFECT: Tremolo
; COLLECTION/SLOT: Guitar modulation / 2
; POT0: Rate | POT1: Depth | POT2: Wave shape
; INPUT: Duplicated mono input summed from ADCL and ADCR
; OUTPUT: Wet-only DACL; product dry/wet mix is external
; STATUS: Hardware-tested; test date and matrix not recorded

equ lfo reg0
equ lfo_raw reg1
equ lfo_squared reg2
equ intensity reg3
equ mono_in reg4
equ lfo_lag reg5
equ crossfade reg6

equ lag_coeff 0.2

skp run, main
wlds 0, 0, 32767

main:
  ; --- CONTROLS ---
  ; Rate (POT0)
  rdax pot0, 1.0
  sof 0.3, 0.05
  wrax sin0_rate, 0

  ; Depth (POT1)
  rdax pot1, 1.0
  sof 0.45, 0.55
  wrax intensity, 0

  ; Wave shape (POT2)
  rdax pot2, 1.0
  wrax crossfade, 0

  ; --- LFO ---
  ; Raw LFO
  cho rdal, sin0
  sof 0.5, 0.5
  wrax lfo_raw, 0

  ; Squared LFO
  rdax lfo_raw, 1.0
  sof 1.5, 0
  sof 1.5, 0
  wrax lfo_squared, 0

  ; Crassfade the LFOs
  rdax lfo_raw, -1.0
  rdax lfo_squared, 1.0
  mulx crossfade
  rdax lfo_raw, 1.0
  ; Slow it down
  rdfx lfo_lag, lag_coeff
  wrax lfo_lag, 1.0
  ; Depth
  mulx intensity
  wrax lfo, 0

  ; --- AUDIO ---
  ; Sum inputs
  rdax adcl, 0.5
  rdax adcr, 0.5
  wrax mono_in, 0

  ; VCA
  rdax lfo, 1.0
  sof -1.0, 0.999
  mulx mono_in

  ; Output
  wrax dacl, 0
