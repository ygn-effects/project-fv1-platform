equ mono_in reg0
equ lpf_state reg1
equ hpf_state reg2
equ lfo reg3
equ lfo_inv reg4
equ wet_temp reg5
equ lpf_freq reg6
equ hpf_freq reg7

skp run, main
wlds 0, 10, 32767

main:
  ; --- CONTROLS ---
  ; Rate (POT0)
  rdax pot0, 1.0
  sof 0.10, 0.04
  wrax sin0_rate, 0

  ; Depth (POT1)
  rdax pot1, 1.0
  sof 0.8, 0.2
  wrax sin0_range, 0

  ; Frequency (POT2)
  ; Low band
  rdax pot2, 1.0
  sof 0.1, 0.05
  wrax lpf_freq, 0

  ; High band
  rdax pot2, 1.0
  sof 0.1, 0.1
  wrax hpf_freq, 0    ; Store and Clear

  ; --- LFO ---
  ; Read the current LFO value
  cho rdal, sin0
  ; Normalize to 0-1
  sof 0.5, 0.5
  wrax lfo, 1.0
  ; Invert and offset to 0-1
  sof -1.0, 0.999
  wrax lfo_inv, 0

  ; --- AUDIO ---
  rdax adcl, 0.5
  rdax adcr, 0.5
  wrax mono_in, 1.0

  ; LPF for the low band
  rdax lpf_state, -1.0
  mulx lpf_freq
  rdax lpf_state, 1.0
  wrax lpf_state, 1.0
  ; Gain adjustment
  mulx lfo
  ; Store
  wrax wet_temp, 0

  ; Temporary LPF for the high band
  rdax mono_in, 1.0
  rdax hpf_state, -1.0
  mulx hpf_freq
  rdax hpf_state, 1.0
  wrax hpf_state, 0.0

  ; HPF
  rdax mono_in, 1.0
  rdax hpf_state, -1.0
  ; Gain adjustment
  mulx lfo_inv

  ; Mix and output
  rdax wet_temp, 1.0
  wrax dacl, 0
