{
  "name": "spinasm",
  "displayName": "spinasm",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SpinASM",
      "properties": {
        "spinasm.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Full path to the asfv1 compiler executable.",
          "scope": "machine-overridable"
        },
        "spinasm.compiler.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-s"
          ],
          "description": "Command line arguments passed to the compiler (e.g., -s for SpinASM compatibility)."
        },
        "spinasm.programmer.serialPort": {
          "type": "string",
          "default": "",
          "description": "Serial port for the FV-1 programmer (e.g., COM3 or /dev/ttyUSB0).",
          "scope": "machine-overridable"
        },
        "spinasm.programmer.baudRate": {
          "type": "number",
          "default": 57600,
          "description": "Baud rate for the serial communication.",
          "scope": "machine-overridable"
        },
        "spinasm.editor.compileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically compile SpinASM programs when saving .spn files."
        },
        "spinasm.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show compilation status in the status bar. Useful to disable when batch-compiling EEPROMs."
        }
      }
    },
    "commands": [
      {
        "command": "spinasm.createProject",
        "title": "SpinASM: Create Project"
      },
      {
        "command": "spinasm.checkProjectSettings",
        "title": "SpinASM: Check Hardware Connection"
      },
      {
        "command": "spinasm.showSerialConfig",
        "title": "SpinASM: Show Configuration"
      },
      {
        "command": "spinasm.selectSerialPort",
        "title": "SpinASM: Select Serial Port..."
      },
      {
        "command": "spinasm.autoDetectProgrammer",
        "title": "SpinASM: Auto-Detect Programmer"
      },
      {
        "command": "spinasm.showBankStatus",
        "title": "SpinASM: Show Bank Status"
      },
      {
        "command": "spinasm.showResourceUsage",
        "title": "SpinASM: Show Resource Usage"
      },
      {
        "command": "spinasm.compileBank",
        "title": "SpinASM: Compile Specific Bank..."
      },
      {
        "command": "spinasm.uploadBank",
        "title": "SpinASM: Upload Specific Bank..."
      },
      {
        "command": "spinasm.compileAndUploadBank",
        "title": "SpinASM: Compile & Upload Specific Bank..."
      },
      {
        "command": "spinasm.compileCurrentProgram",
        "title": "SpinASM: Compile current program"
      },
      {
        "command": "spinasm.compileAllPrograms",
        "title": "SpinASM: Compile all programs"
      },
      {
        "command": "spinasm.compileAllProgramsToBin",
        "title": "SpinASM: Compile all programs to .bin"
      },
      {
        "command": "spinasm.uploadAllPrograms",
        "title": "SpinASM: Upload all programs"
      },
      {
        "command": "spinasm.compileAndUploadAllPrograms",
        "title": "SpinASM: Compile & Upload all programs"
      },
      {
        "command": "spinasm.uploadCurrentProgram",
        "title": "SpinASM: Upload current program"
      },
      {
        "command": "spinasm.compileAndUploadCurrentProgram",
        "title": "SpinASM: Compile & Upload current program"
      }
    ],
    "languages": [
      {
        "id": "spinasm",
        "aliases": [
          "SpinASM",
          "spinasm"
        ],
        "extensions": [
          ".spn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spinasm",
        "scopeName": "source.spinasm",
        "path": "./syntaxes/spinasm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "spinasm",
        "path": "./snippets/spinasm.json"
      }
    ],
    "semanticTokenTypes": [
    {
      "id": "variable",
      "superType": "variable",
      "description": "User-defined register aliases"
    },
    {
      "id": "property",
      "superType": "property",
      "description": "Memory buffer names"
    },
    {
      "id": "function",
      "superType": "function",
      "description": "Jump labels"
    },
    {
      "id": "parameter",
      "superType": "parameter",
      "description": "Constant values"
    }
  ],
  "semanticTokenModifiers": [
    {
      "id": "declaration",
      "description": "Symbol definition site"
    },
    {
      "id": "readonly",
      "description": "Constant value"
    }
  ],
  "semanticTokenScopes": [
    {
      "language": "spinasm",
      "scopes": {
        "variable": ["variable.other.spinasm.register"],
        "property": ["variable.other.spinasm.memory"],
        "function": ["entity.name.function.spinasm"],
        "parameter": ["variable.other.constant.spinasm"]
      }
    }
  ],
  "configurationDefaults": {
    "[spinasm]": {
      "editor.semanticHighlighting.enabled": true
    }
  }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "ini": "^5.0.0",
    "serialport": "^12.0.0"
  }
}