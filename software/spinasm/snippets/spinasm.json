{
    "RDAX Instruction": {
      "prefix": "rdax",
      "body": "rdax ${1:REG}, ${2:COEFF}",
      "description": "Read ACCumulate and multiply by COEFF"
    },

    "WRAX Instruction": {
      "prefix": "wrax",
      "body": "wrax ${1:REG}, ${2:COEFF}",
      "description": "Write ACCumulator to REG with COEFF"
    },

    "MULX Instruction": {
      "prefix": "mulx",
      "body": "mulx ${1:REG}",
      "description": "Multiply ACCumulator by REG"
    },

    "RDFX Instruction": {
      "prefix": "rdfx",
      "body": "rdfx ${1:REG}, ${2:COEFF}",
      "description": "Read Filter and multiply by COEFF"
    },

    "SOF Instruction": {
      "prefix": "sof",
      "body": "sof ${1:COEFF}, ${2:OFFSET}",
      "description": "Scale and Offset ACCumulator"
    },

    "SKP Instruction": {
      "prefix": "skp",
      "body": "skp ${1:Condition}",
      "description": "Skip instruction based on Condition"
    },

    "JAM Instruction": {
      "prefix": "jam",
      "body": "jam ${1|RMP0,RMP1|}",
      "description": "Reset the specified ramp LFO (RMP0 or RMP1) to its starting position"
    },

    "Basic Effect Skeleton": {
      "prefix": "fxstart",
      "body": [
        "; ${1:Effect Name}",
        "${2:init:}",
        "  ${3:}",
        "",
        "${4:process:}",
        "  ${5:}"
      ],
      "description": "Basic SpinASM effect structure"
    },

    "Input ADC Setup": {
      "prefix": "adcsetup",
      "body": [
        "rdax adcl, 1.0",
        "rdax adcr, 1.0"
      ],
      "description": "Initialize accumulators with ADC inputs"
    },

    "Output DAC Write": {
      "prefix": "dacwrite",
      "body": [
        "wrax dacl, 0",
        "wrax dacr, 0"
      ],
      "description": "Write accumulator to DAC outputs"
    },

    "EQU Directive": {
      "prefix": "equ",
      "body": "${1:LABEL} equ ${2:VALUE}",
      "description": "Define a constant value"
    },

    "MEM Directive": {
      "prefix": "mem",
      "body": "mem ${1:LABEL} ${2:SIZE}",
      "description": "Allocate delay memory (mem NAME SIZE)"
    },

    "Run-once Init Block": {
      "prefix": "skprun",
      "body": [
        "skp run, ${1:main}",
        "; one-time init — runs only on the first sample",
        "${2:}",
        "${1:main}:",
        "; main processing — runs every sample",
        "${3:}"
      ],
      "description": "Skip initialization after the first sample (SKP RUN pattern)"
    }
  }
